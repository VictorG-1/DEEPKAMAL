# Optional — DeepKamal runs on SQLite by default.
# Add these to enable Supabase status reporting / future sync.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Optional Razorpay — without keys, checkout runs in local demo mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Dispatch map HQ (default Gurugram) + company letterhead for tax PDFs
DEEPKAMAL_HQ_LAT=28.4595
DEEPKAMAL_HQ_LNG=77.0266
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS=DeepKamal Electrical & Fire Safety
COMPANY_EMAIL=ops@deepkamal.in
COMPANY_PHONE=

# Nightly backup: npm run backup:nightly
# Hosted move: npm run db:export-supabase  (then import JSON into Supabase)
