# Supabase — required for Vercel (SQLite cannot persist on serverless)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Postgres connection (Supabase Session pooler recommended)
# Format: postgresql://deepkamal_app.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://deepkamal_app.PROJECTREF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-in-production

# Optional Razorpay — without keys, checkout runs in local demo mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

DEEPKAMAL_HQ_LAT=28.4595
DEEPKAMAL_HQ_LNG=77.0266
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS=DeepKamal Electrical & Fire Safety
COMPANY_EMAIL=ops@deepkamal.in
COMPANY_PHONE=
