# REQUIRED on Vercel (Project → Settings → Environment Variables → Redeploy)
# Without DATABASE_URL the site returns FUNCTION_INVOCATION_FAILED / 500.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Postgres Transaction pooler (port 6543) — required for Vercel/serverless
# Session mode :5432 hits "max clients reached" under load. URL-encode ! as %21
# Example: postgresql://deepkamal_app.PROJECTREF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://deepkamal_app.PROJECTREF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-in-production

# Optional Razorpay — without keys, checkout runs in local demo mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

DEEPKAMAL_HQ_LAT=19.2305
DEEPKAMAL_HQ_LNG=72.8470
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS=DeepKamal Electrical & Fire Safety
COMPANY_EMAIL=ops@deepkamal.in
COMPANY_PHONE=

# Combirds / Edumarc SMS — OTP login, work start, completion
COMBIRDS_API_KEY=your_combirds_api_key
COMBIRDS_SENDER_ID=TFLSTK
COMBIRDS_TEMPLATE_ID=your_dlt_template_id
COMBIRDS_TEMPLATE_FIRST_VAR=KMS
COMBIRDS_SMS_BASE_URL=https://smsapi.edumarcsms.com
COMBIRDS_SMS_PATH=/api/v1/sms/send
# Optional override; must match DLT template. Placeholders: {brand} {otp}
# COMBIRDS_OTP_MESSAGE_TEMPLATE=Your {brand} OTP is {otp}

