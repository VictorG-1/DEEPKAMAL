{
  "installCommand": "npm install --omit=optional",
  "buildCommand": "node -e \"console.log('DeepKamal build ok', process.version)\"",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{public/**,server/**}"
    }
  }
}
